        "conversation_id": "e54d139e-f5e3-403a-8fed-3dc5158080a5",
        "role": "assistant",
        "content": "IT must revoke a departing employee's access within 2 hours of the employee's exit time. The exact time depends on when the employee's last working day ends.",
        "attachments": [],
        "confidence": 0.8653,
        "model_name": "python-rag-ollama",
        "metadata": {
          "user_id": "dev-admin",
          "user_name": "Administrator",
          "query_id": "6209fee5-2d3c-40eb-8e89-071c7abf6017",
          "queryId": "6209fee5-2d3c-40eb-8e89-071c7abf6017",
          "sources": [
