        "role": "assistant",
        "content": "IT must revoke a departing employee's access within 2 hours of the employee's exit time. The exact time is determined by the employee's last working day.",
        "attachments": [],
        "confidence": 0.8669,
        "model_name": "python-rag-ollama",
        "metadata": {
