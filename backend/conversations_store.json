              "page_is_reliable": true,
              "score": 0.8441,
              "relevance_score": 0.8441,
              "excerpt": "Full backups run nightly at 01:00 WIB. Daily backups are retained for 30 days; monthly backups for 12 months.",
              "citation_validated": true,
