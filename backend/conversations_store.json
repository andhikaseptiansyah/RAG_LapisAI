        "role": "user",
        "content": "When must IT reoke a departing employee's access?",
        "attachments": [],
        "confidence": null,
        "model_name": null,
        "metadata": {
          "user_id": "dev-admin",
          "user_name": "Administrator",
          "query_id": "6209fee5-2d3c-40eb-8e89-071c7abf6017",
          "queryId": "6209fee5-2d3c-40eb-8e89-071c7abf6017"
