        "role": "assistant",
        "content": "Insiden IT P1 harus diakui dalam 15 menit. diselesaikan dalam 4 jam.",
        "attachments": [],
        "confidence": 0.8422,
        "model_name": "python-rag-ollama",
        "metadata": {
