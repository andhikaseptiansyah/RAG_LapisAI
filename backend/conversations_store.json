              "page": 1,
              "page_is_reliable": true,
              "score": 0.8669,
              "relevance_score": 0.8669,
              "excerpt": "Departing employees must return all company assets (laptop, access card, phone) on their last working day. IT revokes all system access within 2 hours of the employee's exit time.",
              "citation_validated": true,
              "citation_support_score": 0.9306,
