        "role": "assistant",
        "content": "Full database backups are taken nightly at 01:00 WIB. Full backups are also run every 6 hours.",
        "attachments": [],
        "confidence": 0.7279,
        "model_name": "python-rag-ollama",
        "metadata": {
          "user_id": "dev-admin",
          "user_name": "Administrator",
